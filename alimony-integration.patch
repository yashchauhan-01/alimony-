+    "id"         SERIAL PRIMARY KEY,
+    "caseId"     INTEGER NOT NULL UNIQUE,
+    "userId"     INTEGER NOT NULL,
+    "answers"    TEXT NOT NULL,
+    "safetyFlag" BOOLEAN NOT NULL DEFAULT false,
+    "createdAt"  TIMESTAMPTZ NOT NULL DEFAULT now()
+);
