+  it("forwards the new read routes only with a session", async () => {
+    for (const path of [
+      "cases/7/intake",
+      "cases/7/navigator",
+      "cases/7/checklist",
+      "documents/case/7",
+    ]) {
+      const result = await GET(
+        new NextRequest(`${base}/api/backend/${path}`),
+        ctx(path),
