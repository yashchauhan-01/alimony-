+      new NextRequest(`${base}/api/backend/cases/7/intake`, {
+        method: "POST",
+        headers: { origin: "https://other.example" },
+      }),
+      ctx("cases/7/intake"),
+    );
+    expect(crossOrigin.status).toBe(403);
